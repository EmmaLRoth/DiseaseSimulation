<Window x:Class="DiseaseSimulation.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Disease simulation" Height="700" Width="1100" Background="#0B132B">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,10"
                Background="#1C2541">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🦠 Disease Simulation - " FontSize="18" FontWeight="Bold" FontFamily="Lucida Console" Foreground="#CAD5E2"/>
                <TextBlock x:Name="ModelTypeText" 
                           FontWeight="Bold" 
                           FontFamily="Lucida Console"
                           Foreground="#007ACC"
                           FontSize="20"
                           Margin="20, 0, 0, 0"/>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" 
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="#1C2541" 
                    CornerRadius="5" 
                    Padding="10" 
                    Margin="0,0,10,10">
                <Border BorderThickness="1" 
                        CornerRadius="3" 
                        Background="#CAD5E2">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Grid x:Name="MapGrid" />
                    </Viewbox>
                </Border>
            </Border>
            
            <Border Grid.Column="1"
            BorderBrush="Gray"
            BorderThickness="1"
            Background="#1C2541"
            CornerRadius="5"
            Padding="10"
            Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="📊 Statistics"
                       FontSize="14" FontWeight="Bold"
                       FontFamily="Lucida Console"
                       Foreground="#CAD5E2"
                       Margin="0,0,0,10"/>

            <!-- Current day counters -->
            <TextBlock x:Name="DayText"       Text="Day: 0"            Foreground="#CAD5E2" FontFamily="Lucida Console" Margin="0,2"/>
            <TextBlock x:Name="TotalText"     Text="Total:  0"         Foreground="#CAD5E2" FontFamily="Lucida Console" Margin="0,2"/>
            <TextBlock x:Name="SusceptText"   Text="🟢 Susceptible: 0" Foreground="LightGreen" FontFamily="Lucida Console" Margin="0,2"/>
            <TextBlock x:Name="ExposedText"   Text="🟡 Exposed:     0" Foreground="Gold"       FontFamily="Lucida Console" Margin="0,2"/>
            <TextBlock x:Name="InfectedText"  Text="🔴 Infected:    0" Foreground="Salmon"     FontFamily="Lucida Console" Margin="0,2"/>
            <TextBlock x:Name="RecoveredText" Text="⚪ Recovered:   0" Foreground="LightGray"  FontFamily="Lucida Console" Margin="0,2"/>

            <Separator Margin="0,10" Background="Gray"/>

            <!-- Scrollable history log -->
            <TextBlock Text="History" Foreground="#CAD5E2" FontFamily="Lucida Console" Margin="0,0,0,5"/>
            <ScrollViewer x:Name="StatsScroller" Height="350" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StatsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Lucida Console" FontSize="10" Foreground="#CAD5E2"
                                       Text="{Binding Display}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
        </Grid>
        
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,0"
                Background="#1C2541">
            
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,10">
                <Button Content="▶ Start"   Click="StartButton_Click"    Width="85" Height="30" Margin="5,0" FontFamily="Lucida Console" Background="#FFB7C3" Foreground="Black"/>
                <Button Content="Step"   Click="StepButton_Click"    Width="85" Height="30" Margin="5,0" FontFamily="Lucida Console" Background="#FFB7C3" Foreground="Black"/>
                <Button Content="⏸ Pause"   Click="PauseButton_Click"    Width="85" Height="30" Margin="5,0" FontFamily="Lucida Console" Background="#FFB7C3" Foreground="Black"/>
                <Button Content="⏹ Stop"    Click="StopButton_Click"     Width="85" Height="30" Margin="5,0" FontFamily="Lucida Console" Background="#FFB7C3" Foreground="Black"/>
                <Button Content="⚙ Settings" Click="SettingsButton_Click" Width="85" Height="30" Margin="5,0" FontFamily="Lucida Console" Background="#FFB7C3" Foreground="Black"/>
                <Border Width="140" 
                         Height="30" 
                         Margin="5,0" 
                         Background="#FFB7C3"
                         CornerRadius="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>      <!-- Slider takes available space -->
                            <ColumnDefinition Width="Auto"/>   <!-- Text fits its content -->
                        </Grid.ColumnDefinitions>
        
                        <Slider Grid.Column="0"
                                Minimum="0" 
                                Maximum="100" 
                                Value="50"
                                Margin="8,0,4,0"          
                                VerticalAlignment="Center"
                                Foreground="Black"
                                Background="Transparent"/>
                
                        <TextBlock Grid.Column="1"
                                   Text="Speed"
                                   FontFamily="Lucida Console"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>       <!-- Right padding so not at edge -->
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
        
        
        
    </Grid>
</Window>
